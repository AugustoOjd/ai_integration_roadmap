# Interpolado en docker-compose.yml, así las credenciales se escriben una vez.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mini_db

# Puerto en TU máquina. Cámbialo por mini si quieres varios levantados a la vez
# (mini-1/2 usan 5432, mini-4 el 5433). Dentro de Docker siempre es 5432.
POSTGRES_PORT=5432

# Para la app corriendo fuera de Docker. Debe coincidir con POSTGRES_PORT.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mini_db
