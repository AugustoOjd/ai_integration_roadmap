# Raw credentials, reused by docker-compose.yml (${VAR} interpolation) to build
# the connection URLs below without repeating "postgres/password/mini_db" twice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mini_db

# Used by the app itself (via app/config.py) when running outside Docker
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mini_db
REDIS_URL=redis://localhost:6379/0
