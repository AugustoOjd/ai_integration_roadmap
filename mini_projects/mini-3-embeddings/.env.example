# Which sentence-transformers model to load, downloaded from Hugging Face on
# first use and cached in ~/.cache/huggingface afterwards.
#
# The app reads each model's output dimension from the model itself, so there is
# nothing else to keep in sync when you change these.
#
#   all-MiniLM-L6-v2                        English-focused, fastest, ~90MB
#   all-mpnet-base-v2                       English, better quality, slower
#   paraphrase-multilingual-MiniLM-L12-v2   Multilingual — much better at Spanish

# Used by alias "default"
MODEL_NAME=all-MiniLM-L6-v2

# Used by alias "alt" — loaded lazily, only when you actually ask for it
ALT_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
