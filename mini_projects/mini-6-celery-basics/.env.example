# Puerto en TU máquina. Cámbialo si ya tienes otro mini levantado con Redis
# (mini-2 usa el 6379). Dentro de Docker siempre es 6379.
REDIS_PORT=6379

# Para la app y el worker corriendo FUERA de Docker. Debe coincidir con REDIS_PORT.
# El /0 al final es el número de base de datos de Redis (hay 16, 0-15).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
