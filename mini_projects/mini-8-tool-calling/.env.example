# La API key de Anthropic. NO tiene default en config.py a propósito: es el
# único setting sin el cual la app no puede hacer absolutamente nada, así que
# preferimos que el proceso muera al arrancar con un error claro de Pydantic
# antes que fallar en el primer request.
ANTHROPIC_API_KEY=sk-ant-...

# El modelo. Haiku 4.5 es barato ($1/$5 por millón de tokens de entrada/salida)
# y este mini hace VARIAS llamadas por request: un loop de tools de 3 vueltas
# son 3 llamadas, y el historial se reenvía entero en cada una.
#
# Está acá y no hardcodeado para que puedas cambiarlo en una línea. Si una fase
# se te complica, subir a `claude-opus-5` te dice si el problema es tu código o
# es que el modelo no llega.
ANTHROPIC_MODEL=claude-haiku-4-5

# Techo de tokens que el modelo puede GENERAR por respuesta (no incluye lo que
# vos le mandás). Si lo toca, la respuesta se corta a la mitad y `stop_reason`
# vuelve como "max_tokens".
#
# 4096 es bajo a propósito y alcanza: en este mini los turnos son cortos (un
# bloque `tool_use` son unos pocos tokens). Para texto largo el default sano
# ronda los 16000.
ANTHROPIC_MAX_TOKENS=4096
