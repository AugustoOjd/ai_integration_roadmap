# Copiá este archivo a `.env` y completá la API key:
#     cp .env.example .env

# ---------------------------------------------------------------------------
# Modelo
# ---------------------------------------------------------------------------

# La API key de Anthropic. NO tiene default en config.py a propósito: es el
# único setting sin el cual la app no puede hacer nada, así que preferimos que
# el proceso muera al arrancar con un error claro de Pydantic antes que fallar
# en el primer request.
ANTHROPIC_API_KEY=sk-ant-...

# El modelo. Haiku 4.5 es barato ($1/$5 por millón de tokens de entrada/salida)
# y este mini hace VARIAS llamadas por request. Si una fase se te complica,
# subir a `claude-opus-5` te dice si el problema es tu código o es que el modelo
# no llega.
ANTHROPIC_MODEL=claude-haiku-4-5

# Techo de tokens que el modelo puede GENERAR por respuesta (no incluye lo que
# vos le mandás). Si lo toca, la respuesta se corta y `stop_reason` vuelve como
# "max_tokens".
ANTHROPIC_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------

# Tiene que coincidir con el usuario, password, puerto y base del
# docker-compose.yml. El `+asyncpg` no es decorativo: nombra el driver, y sin él
# SQLAlchemy elige el sincrónico y `create_async_engine` falla.
#
# Si cambiaste el puerto del host en docker-compose.yml (por ejemplo a 5433
# porque ya tenías un Postgres local), cambialo también acá.
DATABASE_URL=postgresql+asyncpg://mini9:mini9@localhost:5432/mini9

# Imprime todo el SQL que emite SQLAlchemy. Ruidoso; prendelo un rato cuando
# quieras ver qué está haciendo la persistencia de verdad.
DB_ECHO=false

# ---------------------------------------------------------------------------
# Agente
# ---------------------------------------------------------------------------

# Tope de vueltas del loop: protege contra el modelo que se queda dando vueltas.
AGENT_MAX_ITERATIONS=8

# Presupuesto inicial de una sesión nueva, en tokens de entrada acumulados.
# Protege contra el gasto, que es un problema distinto del loop infinito.
DEFAULT_BUDGET_TOKENS=50000

# Precios de Haiku 4.5, en dólares por millón de tokens. Entrada y salida
# cuestan distinto: por eso son dos números y no uno.
PRECIO_INPUT_USD_POR_MTOK=1.0
PRECIO_OUTPUT_USD_POR_MTOK=5.0

# Techo de contexto por request. Haiku 4.5 tiene 200K de ventana; este número va
# por debajo a propósito, porque el límite del modelo incluye lo que él genera
# y llegar justo significa que la respuesta se corta por falta de lugar.
CONTEXT_MAX_INPUT_TOKENS=150000
