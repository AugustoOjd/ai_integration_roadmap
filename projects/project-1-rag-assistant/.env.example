# Plantilla. Copiar a .env y rellenar. El .env real nunca se commitea.

ENVIRONMENT=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag_db

POSTGRES_PORT=5435
REDIS_PORT=6380

DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAR@localhost:5435/rag_db
REDIS_URL=redis://localhost:6380/0

# Proveedor del LLM, por API compatible con OpenAI.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Autenticacion de esta API (cabecera X-API-Key).
# Generar con: openssl rand -hex 32
API_KEY=
