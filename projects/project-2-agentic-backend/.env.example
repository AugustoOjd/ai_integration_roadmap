# cp .env.example .env y completá la API key.

# Sin default en config.py: si falta, el proceso no arranca.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Tokens que el modelo puede generar por respuesta.
ANTHROPIC_MAX_TOKENS=4096

# Timeout de una llamada al modelo, en segundos.
ANTHROPIC_TIMEOUT=30.0

# Tiene que coincidir con el docker-compose.yml. El `+psycopg` es el driver
# sincrónico; con `+asyncpg` (el del mini 9) create_engine falla.
DATABASE_URL=postgresql+psycopg://agentic:agentic@localhost:5432/agentic_backend

# Imprime todo el SQL que emite SQLAlchemy.
DB_ECHO=false

# Tope de vueltas del loop.
AGENT_MAX_ITERATIONS=8

# Presupuesto por defecto, en tokens de input acumulados.
DEFAULT_BUDGET_TOKENS=50000

# Dólares por millón de tokens.
PRECIO_INPUT_USD_POR_MTOK=1.0
PRECIO_OUTPUT_USD_POR_MTOK=5.0

# Techo de contexto por request, debajo de los 200K de la ventana.
CONTEXT_MAX_INPUT_TOKENS=150000

# Broker y backend de Celery. Bases distintas de Redis para que un FLUSHDB sobre
# los resultados no se lleve la cola.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Dead letter queue: tercera base de Redis, porque es lo único que no querés
# perder en un FLUSHDB.
DEAD_LETTER_URL=redis://localhost:6379/2
DEAD_LETTER_KEY=dlq:agent
DEAD_LETTER_MAX=500
