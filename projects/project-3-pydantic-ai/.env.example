# cp .env.example .env  — .env está en .gitignore, este archivo no.

ANTHROPIC_API_KEY=sk-ant-...

# Opcionales, para la fase 5. Sólo hace falta la del provider que uses.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...

# "<provider>:<modelo>". Lo único que se toca para cambiar de provider.
AGENT_MODEL=anthropic:claude-haiku-4-5

# 5433: el puerto del docker-compose de este proyecto.
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5433/triage

DB_ECHO=false

# Fase 7. Sin LOGFIRE_TOKEN las spans se imprimen en la consola.
LOGFIRE=false
# LOGFIRE_TOKEN=
