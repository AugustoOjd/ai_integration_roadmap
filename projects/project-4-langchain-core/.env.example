# cp .env.example .env  — .env está en .gitignore, este archivo no.

# Embeddings. Anthropic no tiene, así que este provider es obligatorio.
# Free tier en https://voyageai.com
VOYAGE_API_KEY=pa-...

ANTHROPIC_API_KEY=sk-ant-...

# "<provider>:<modelo>", el formato de init_embeddings / init_chat_model.
EMBEDDING_MODEL=voyageai:voyage-3.5-lite
CHAT_MODEL=anthropic:claude-haiku-4-5

# ⚠️ psycopg y NO asyncpg: langchain-postgres sólo soporta psycopg3.
DATABASE_URL=postgresql+psycopg://nordix:nordix@localhost:5436/nordix

REDIS_URL=redis://localhost:6381/0

# Cómo se parte el corpus. Son decisiones tuyas, no del splitter.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4
