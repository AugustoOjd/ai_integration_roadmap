# cp .env.example .env  — .env is gitignored, this file isn't.

ANTHROPIC_API_KEY=sk-ant-...

# "<provider>:<model>", the format create_agent / init_chat_model accept.
CHAT_MODEL=anthropic:claude-haiku-4-5

# Plain libpq URL: psycopg reads it directly. No "+psycopg" — that suffix is
# SQLAlchemy's dialect syntax, and there's no SQLAlchemy here.
DATABASE_URL=postgresql://nordix:nordix@localhost:5437/nordix
